# oci-toolkit UK 租户配置 — 复制为 .env 后填写
# 适用于新注册租户（default VCN 方案）；旧租户配置见 .env.example

# ===== 认证 =====
# venv 中的 oci 可执行文件路径（留空则用 PATH 里的 oci）
OCI_BIN="$HOME/oci-arm-relaunch/venv/bin/oci"
# ~/.oci/config 中的 profile 段名
OCI_PROFILE=UK

# ===== 基础 =====
COMPARTMENT_ID="ocid1.tenancy.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# 以下留空 = 自动发现 default VCN / 路由表 / 安全列表 / 子网（单 VCN 租户推荐留空）
VCN_ID=""
SUBNET_ID=""

# ===== launch-vm.sh --x86 =====
# 两台微机的名字（空格分隔）
X86_NAMES="uk-x86-1 uk-x86-2"
X86_AD="XXXX:UK-LONDON-1-AD-1"
# 新建引导卷最小 50GB（实测：OCI 拒绝 <50GB；旧账户的 47GB 是 2021 年遗留值）
X86_BV_GB=50
SSH_KEY_FILE="$HOME/.ssh/id_rsa.pub"

# ===== launch-vm.sh --arm =====
# Always Free 现行限额：2 OCPU / 12GB（2026-08-18 起强制执行）
INSTANCE_ARM_NAME="uk-arm"
SHAPE="VM.Standard.A1.Flex"
OCPUS=2
MEMORY_GB=12
# 50(x86) + 50(x86) + 100(ARM) = 200GB = 免费块存储额度上限，一分不超
ARM_BV_GB=100
# 多 AD 轮换抢容量（oci iam availability-domain list 实测填入）
ADS="XXXX:UK-LONDON-1-AD-1 XXXX:UK-LONDON-1-AD-2 XXXX:UK-LONDON-1-AD-3"
RETRY_INTERVAL=200
JITTER=100
BACKOFF_AFTER_429=5
ASSIGN_PUBLIC_IP=true
