# oci-toolkit 配置 — 复制为 .env 后填写
# 所有 OCID 均从 OCI 控制台或 `oci ... list` 命令获取

# ===== 认证 =====
# OCI CLI profile 名（~/.oci/config 中的段名）
OCI_PROFILE=DEFAULT
# venv 中的 oci 可执行文件路径（留空则用 PATH 里的 oci）
OCI_BIN="$HOME/oci-arm-relaunch/venv/bin/oci"

# ===== 实例定义 =====
COMPARTMENT_ID="ocid1.tenancy.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# 必须与 BOOT_VOLUME_ID 所在可用域完全一致（跨 AD 无法挂载引导卷）
TARGET_AD="XXXX:AP-OSAKA-1-AD-1"
BOOT_VOLUME_ID="ocid1.bootvolume.oc1.ap-osaka-1.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SUBNET_ID="ocid1.subnet.oc1.ap-osaka-1.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
INSTANCE_NAME="arm-recovered"

# Always Free 现行限额：2 OCPU / 12GB（2026-06-15 起砍半，08-18 强制执行）
# 抢机策略：容量碎片小，先抢最小 1/6（V2EX 东京实战验证），到手后关机阶梯升配
SHAPE="VM.Standard.A1.Flex"
OCPUS=2
MEMORY_GB=12

# ===== 网络 =====
ASSIGN_PUBLIC_IP=true
# 需要子网为双栈（IPv6 CIDR 已分配），否则 launch 会报错——脚本会自动降级重试
ASSIGN_IPV6=true

# ===== 轮询 =====
# 基准间隔（秒）+ 0~JITTER 秒随机抖动，避免固定周期轮询特征
RETRY_INTERVAL=200
JITTER=100
# 连续 N 次 429 后把基准间隔翻倍（防触发 API 限制升级）
BACKOFF_AFTER_429=5

# ===== Telegram 通知（launch-vm.sh 与 launch-from-bv.sh 通用）=====
# 找 @BotFather 建 bot 拿 token；@userinfobot 查自己 chat id。留空则静默跳过通知
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# 每 N 次尝试发一条心跳播报（0 关闭；300 次 ≈ 21 小时）
HEARTBEAT_EVERY=300

# ===== launch 前预检 =====
# 轮询前先 list-instances 数存活 A1 实例，达到上限即停（防 .success 丢失后重复开机）
A1_MAX_INSTANCES=1
